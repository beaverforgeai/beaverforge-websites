# Your real connection file. It holds your key. Never commit it.
.mcp.json

# The plugin ships its own connection file. It holds no key, only the names of
# the two environment variables you set on your own machine, so it is committed.
!plugins/beaverforge/.mcp.json

# Local Claude Code settings and state
.claude/settings.local.json
.claude/*.local.*

# Screenshots and scratch files from checking pages
screenshots/
*.png
*.jpg
*.jpeg
*.webp

# Anything you keep private
notes/
*.local
.env
.env.*

# Operating system and editor clutter
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
