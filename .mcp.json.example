{
  "_comment": "Copy this file to .mcp.json, then replace YOUR-SITE.com with your site address and bfai_YOUR_API_KEY with the key you created in WordPress admin under the BeaverForge AI menu, on the page headed BeaverForge AI Settings, in the MCP Server section under Your key. Keep the word Bearer and the space after it. The playwright entry below is the browser Claude uses to look at your pages; leave it as it is. .mcp.json is listed in .gitignore, so your key stays on this machine and is never committed. Fully quit and reopen Claude Code afterwards.",
  "mcpServers": {
    "beaverforge": {
      "command": "npx",
      "args": [
        "-y", "mcp-remote@latest",
        "https://YOUR-SITE.com/wp-json/beaverforge-ai/v1/mcp",
        "--header", "Authorization:${AUTH_HEADER}",
        "--transport", "http-only"
      ],
      "env": { "AUTH_HEADER": "Bearer bfai_YOUR_API_KEY" }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
